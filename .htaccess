# ----------------------------------------------------------------------
# Glossa Production Security Configuration
# ----------------------------------------------------------------------

# 0. Directory Index Priority
DirectoryIndex index.html index.php

# 1. Automatic clean redirect from legacy .php to .html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /glossav1/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)\.php$ $1.html [L,R=301]
</IfModule>

# 2. Disable directory listing
Options -Indexes

# 2. Block direct web access to sensitive dotfiles and SQL dumps
<FilesMatch "(^\.|\.sql$|\.log$|\.md$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Security HTTP Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
